# LLM Router Web Configuration
# Copy this file to .env and fill in the values.

# ======== Required ========
FLASK_SECRET_KEY=<generate-with-python -c "import secrets; print(secrets.token_hex(32))">
LLM_ROUTER_API_KEY=<your-api-key-here>

# ======== Optional ========
# LLM_ROUTER_HOST=http://localhost:8000
# LLM_ROUTER_SERVICES_HOST=http://localhost:5000

# ======== Config Manager ========
LLM_ROUTER_WEB_CFG_HOST=0.0.0.0
LLM_ROUTER_WEB_CFG_PORT=8081
LLM_ROUTER_WEB_CFG_DEBUG=false
DATABASE_URL=sqlite:///configs.db

# ======== Anonymizer ========
LLM_ROUTER_WEB_ANO_HOST=0.0.0.0
LLM_ROUTER_WEB_ANO_PORT=8082
LLM_ROUTER_WEB_ANO_DEBUG=false
